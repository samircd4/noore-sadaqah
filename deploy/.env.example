# Production settings for the VPS (compose.prod.yaml). Copy to deploy/.env on the server, fill in, chmod 600.
# Never commit deploy/.env. Make a secret: openssl rand -base64 48 | tr -d '/+=' | cut -c1-50
# docker compose reads this file twice: for ${...} in compose.prod.yaml and as the backend's environment.

# ---- Site ---------------------------------------------------------------------------------------------------------
DOMAIN=nooresadaqah.org                  # without https://; www. redirects to it
ACME_EMAIL=                              # Let's Encrypt contact (the foundation's address)

# ---- Database and Redis (only on the private Docker network) ------------------------------------------------------
DB_NAME=noore
DB_USER=noore
DB_PASSWORD=
REDIS_PASSWORD=

# ---- Django -------------------------------------------------------------------------------------------------------
DJANGO_SECRET_KEY=
RECEIPT_TOKEN_SECRET=
# Same value in both apps (the frontend gets them from compose.prod.yaml):
REVALIDATE_SECRET=
API_PROXY_SECRET=

# First deploy only: load the fixture content and photos, and create this admin. Then set back to false.
SEED_ON_START=false
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ---- Payments (sandbox until launch day, DEPLOYMENT.md) -----------------------------------------------------------
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true
DONATION_FALLBACK_EMAIL=donations@nooresadaqah.org

# ---- Email (the real SMTP server) ---------------------------------------------------------------------------------
EMAIL_PROVIDER=smtp
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=রসিদ <receipts@nooresadaqah.org>

# ---- Uploads ------------------------------------------------------------------------------------------------------
# Default: on the VPS disk (Docker volume "media"), served by Caddy at https://DOMAIN/media/, backed up by backup.sh.
# To use Cloudflare R2 instead: MEDIA_STORAGE=s3, the MEDIA_* values, and MEDIA_URL / MEDIA_HOST = the R2 domain.
MEDIA_STORAGE=local
# MEDIA_URL=https://media.nooresadaqah.org/
# MEDIA_HOST=media.nooresadaqah.org
# MEDIA_BUCKET=
# MEDIA_ENDPOINT_URL=
# MEDIA_ACCESS_KEY_ID=
# MEDIA_SECRET_ACCESS_KEY=
# MEDIA_PUBLIC_HOST=media.nooresadaqah.org

# ---- Sizing (Hostinger KVM 2: 2 vCPU, 8 GB) -----------------------------------------------------------------------
WEB_CONCURRENCY=3
CELERY_CONCURRENCY=2
