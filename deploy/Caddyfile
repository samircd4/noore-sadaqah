# Caddy in front of the site on the VPS (compose.prod.yaml): HTTPS from Let's Encrypt (renewed by itself) and the
# routing in routes.caddy. Use this when nothing else on the VPS needs ports 80/443.
# Another web server already on 80/443? Use PROXY=nginx instead (deploy/Caddyfile.behind-nginx, DEPLOYMENT.md).
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	import /etc/caddy/routes.caddy
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
