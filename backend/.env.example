# Copy to backend/.env and fill in. Never commit backend/.env.
# Make a secret: uv run python -c "import secrets; print(secrets.token_urlsafe(50))"

# Django
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database (the root compose.yaml creates it with these values on its first start)
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=your_db_host
DB_PORT=your_db_port

# Redis
REDIS_URL=redis://127.0.0.1:6379/0

# Website address (SSLCommerz sends donors back here)
SITE_URL=http://localhost:3000

# After an admin save Django tells Next.js to refresh its cache. Same secret as frontend/.env.local.
# Both empty = off (pages then refresh on their own within minutes). Docker sets both for you.
FRONTEND_INTERNAL_URL=
REVALIDATE_SECRET=

# Uploaded photos and PDFs. Development: /media/ (Django serves it). Production: the R2 public address.
MEDIA_URL=/media/
# local = this machine's disk. s3 = Cloudflare R2 (required on SnapDeploy, which has no lasting disk), with:
MEDIA_STORAGE=local
MEDIA_BUCKET=
MEDIA_ENDPOINT_URL=                    # https://<account id>.r2.cloudflarestorage.com
MEDIA_ACCESS_KEY_ID=
MEDIA_SECRET_ACCESS_KEY=
MEDIA_PUBLIC_HOST=                     # media.nooresadaqah.org

# Hosting without Nginx (SnapDeploy, DEPLOYMENT.md). DATABASE_URL / REDIS_URL come from the host's add-ons.
# API_PROXY_SECRET: same value as the frontend's, so Django trusts the visitor IP it forwards. Empty on the VPS.
API_PROXY_SECRET=
# Production image only (start.sh): the Celery worker runs in the same container unless RUN_WORKER=false;
# SEED_ON_START=true loads the fixtures on the first deploy.
RUN_WORKER=true
SEED_ON_START=false

# Signs receipt links
RECEIPT_TOKEN_SECRET=

# SSLCommerz sandbox account
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true

# Email. Development: Mailpit from the root compose.yaml (inbox at http://127.0.0.1:8025), no login.
# Production: the real SMTP server, e.g. EMAIL_HOST=smtp.example.com EMAIL_PORT=587 EMAIL_USE_TLS=true + user/password.
# EMAIL_PROVIDER=console prints emails in the Celery log instead.
EMAIL_PROVIDER=smtp
EMAIL_HOST=127.0.0.1
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=রসিদ <receipts@nooresadaqah.org>

# Windows only: the folder where MSYS2 installed Pango, which receipt PDFs need (leave empty on Ubuntu)
WEASYPRINT_DLL_DIRECTORIES=

# Optional: admin user created by `uv run python manage.py seed`
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
