# Copy to backend/.env and fill in. Never commit backend/.env.
# Make a secret: uv run python -c "import secrets; print(secrets.token_urlsafe(50))"

# Django
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database (docker-compose.dev.yml creates it with these values)
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=your_db_host
DB_PORT=your_db_port

# Redis
REDIS_URL=redis://127.0.0.1:6379/0

# Website address (SSLCommerz sends donors back here)
SITE_URL=http://localhost:3000

# Signs receipt links
RECEIPT_TOKEN_SECRET=

# SSLCommerz sandbox account
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true

# Optional: admin user created by `uv run python manage.py seed`
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
