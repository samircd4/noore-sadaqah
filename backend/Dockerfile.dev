# Local development image for Django and Celery, used by docker-compose.dev.yml.
# Production does not use Docker (DEPLOYMENT.md). The code is not copied in: compose mounts backend/ at
# /app/backend, so edits on the host show up at once (runserver reloads; restart the worker by hand).
FROM python:3.14-slim

# Pango + HarfBuzz for WeasyPrint's receipt PDFs (the fonts are embedded from static/fonts/).
RUN apt-get update \
    && apt-get install -y --no-install-recommends libpango-1.0-0 libpangoft2-1.0-0 libharfbuzz0b libharfbuzz-subset0 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.12.17 /uv /uvx /usr/local/bin/

# The venv lives outside the mounted folder, so it never mixes with the host's Windows .venv.
ENV UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app/backend
COPY pyproject.toml uv.lock .python-version ./
# Dev group included, so pytest and ruff run in the container too.
RUN uv sync --frozen

EXPOSE 8000
CMD ["uv", "run", "python", "manage.py", "runserver", "0.0.0.0:8000"]
