# Local development image for the Next.js dev server, used by the root compose.yaml.
# Production uses Dockerfile (compose.prod.yaml, DEPLOYMENT.md). The code is not copied in: compose mounts frontend/ at
# /app/frontend, so edits on the host show up at once. node_modules is installed here, inside the image, and kept
# in its own volume, so the host's Windows node_modules (with Windows-only binaries) is never used.
FROM node:22-slim

WORKDIR /app/frontend
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

ENV NEXT_TELEMETRY_DISABLED=1 \
    WATCHPACK_POLLING=true
EXPOSE 3000
# -H 0.0.0.0: listen on the container's network, not only inside it
CMD ["npx", "next", "dev", "-H", "0.0.0.0", "-p", "3000"]
