# Copy to .env.local for development. Never commit .env.local or any real secret.
# Full list and meaning: docs/ARCHITECTURE.md "Environment variables".

# Where data comes from: mock | static | live (docs/ARCHITECTURE.md "API modes")
API_MODE=mock
# During the backend phases: groups already served by Django, e.g. content,forms (the rest stays mocked)
API_LIVE_GROUPS=
# 1 only for a staging demo or CI build that must run in mock mode
ALLOW_MOCK_IN_PRODUCTION=
# Mock only: 1 makes POST /donations/ answer 502 gatewayUnavailable, to test the checkout's error message
MOCK_GATEWAY_DOWN=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_MEDIA_HOST=                            # public R2 domain, e.g. media.nooresadaqah.org
API_INTERNAL_URL=http://127.0.0.1:8000/api/v1      # server only; needed when anything is served by Django
REVALIDATE_SECRET=                                 # same value as the backend's
NEXT_PUBLIC_GA_ID=                                 # optional, loaded only after cookie consent
NEXT_PUBLIC_META_PIXEL_ID=                         # optional, loaded only after cookie consent
SENTRY_DSN=                                        # optional
